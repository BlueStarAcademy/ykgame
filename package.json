{
  "name": "ykgame",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "test:scale": "tsx --test tests/database-pool-config.test.ts tests/request-idempotency.test.ts tests/dump-reward-outbox.test.ts tests/hot-api-observability.test.ts tests/redis-scale.test.ts tests/session-scale.test.ts tests/atomic-mutation.test.ts tests/load-test-config.test.mjs tests/chat.test.ts",
    "load:check": "node scripts/load/validate-config.mjs",
    "load:smoke": "node scripts/load/run.mjs --smoke",
    "load:mixed": "node scripts/load/run.mjs",
    "db:migrate": "node scripts/run-prisma-direct.mjs migrate dev",
    "db:deploy": "node scripts/run-prisma-direct.mjs migrate deploy && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/run-prisma-direct.mjs migrate reset --force",
    "assets:generate": "node scripts/generate-game-sprites.mjs",
    "assets:yanmar-controls": "node scripts/generate-yanmar-premium-controls.mjs",
    "assets:locale-copy": "node scripts/copy-locale-assets.mjs",
    "assets:site-legend-titles": "node scripts/gen-site-legend-titles.mjs",
    "assets:hourly-ads-locale": "node scripts/gen-hourly-ad-locales.mjs",
    "i18n:smoke": "node scripts/i18n-smoke.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "check:text": "npm run check:encoding && npm run check:i18n-keys && npm run i18n:smoke",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.185.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.6",
    "pg": "^8.22.0",
    "phaser": "^4.2.0",
    "prisma": "^7.8.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.1.0",
    "three": "^0.185.1",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
